---
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

// Lee las preguntas desde src/content/faq (las que edita Keystatic) al hacer el build.
const reader = createReader(process.cwd(), keystaticConfig);
const faq = (await reader.collections.faq.all())
  .map((e) => e.entry)
  .sort((a, b) => a.orden - b.orden);
---
<section class="faq" id="faq"><div class="w">
  <div><span class="lab">Preguntas frecuentes</span><h2>Lo que suelen preguntarme.</h2></div>
  <div class="qs">
    {faq.map((f) => (
      <details><summary>{f.pregunta}</summary><p>{f.respuesta}</p></details>
    ))}
  </div>
</div></section>
