---
// Plantilla provisional para páginas que aún no tienen contenido.
// Cuando una página esté lista, sustituye este componente por su contenido real.
interface Props {
  etiqueta: string;
  titulo: string;
  texto: string;
}
const { etiqueta, titulo, texto } = Astro.props;
---
<section class="pagina"><div class="w">
  <div class="head">
    <span class="lab">{etiqueta}</span>
    <h1>{titulo}</h1>
    <p>{texto}</p>
  </div>
  <div class="wip">
    <strong>Esta página está en construcción.</strong>
    <p>Pronto encontrarás aquí todo el contenido. Mientras tanto, cuéntame qué necesitas.</p>
    <div class="acts">
      <a class="btn p" href="/#contacto">Hablemos de tu proyecto</a>
      <a class="btn" href="/">Volver al inicio</a>
    </div>
  </div>
</div></section>
