---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';

interface Props {
  /** Obligatorio y único por página. */
  title: string;
  /** Obligatorio y único por página (ideal: 120–160 caracteres). */
  description: string;
  /** Imagen al compartir el enlace, ruta dentro de /public. */
  ogImage?: string;
  /** true para páginas que no quieres en Google (gracias, borradores...). */
  noindex?: boolean;
}

const { title, description, ogImage = '/og-image.png', noindex = false } = Astro.props;

// Si olvidas el título o la descripción, el build falla y no se publica nada a medias.
if (!title || !description) {
  throw new Error(`Falta title o description en la página ${Astro.url.pathname}`);
}

// Canonical y URLs absolutas: se calculan solos a partir de "site" (astro.config.mjs).
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImageUrl = Astro.site ? new URL(ogImage, Astro.site).href : ogImage;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#20201e" />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  {canonical && <link rel="canonical" href={canonical} />}

  <!-- Open Graph / redes y WhatsApp -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="SC Presencia Digital" />
  <meta property="og:locale" content="es_DO" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {canonical && <meta property="og:url" content={canonical} />}
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="icon" type="image/png" href="/assets/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Fraunces:opsz,wght@9..144,700;9..144,900&family=Roboto+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <Nav />
  <main id="top">
    <slot />
  </main>
  <Footer />
  <WhatsAppFab />
  <script>
    import '../scripts/comun.js';
  </script>
</body>
</html>
