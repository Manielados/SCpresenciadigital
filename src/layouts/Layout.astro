---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'SC Presencia Digital · Webs para profesionales y negocios de servicios',
  description = 'Diseño webs para profesionales y negocios de servicios que necesitan convertir interés en confianza y acción. Primero entiendo, investigo y propongo; construyo cuando tú apruebas.',
} = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#20201e" />
  <link rel="icon" type="image/png" href="/assets/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Fraunces:opsz,wght@9..144,700;9..144,900&family=Roboto+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <slot />
  <script>
    import '../scripts/cotizador.js';
  </script>
</body>
</html>
